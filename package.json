{
  "name": "burn-rate",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check": "turbo run check",
    "test": "turbo run test",
    "generate": "turbo run generate",
    "check:generated": "pnpm generate && node scripts/check-generated.mjs",
    "db:migrate": "pnpm --filter @burn-rate/api db:migrate",
    "db:cutover": "pnpm --filter @burn-rate/api db:cutover",
    "test:database": "pnpm --filter @burn-rate/api test:database"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "tsx": "4.23.15",
    "turbo": "^2.11.10"
  }
}
