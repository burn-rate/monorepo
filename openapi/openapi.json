          "ingest": {
            "type": "object",
            "properties": {
              "format": {
                "type": "string",
                "enum": [
                  "health-exporter-v1",
                  "metrics-v1",
                  "unknown"
                ]
              },
              "received": {
                "type": "integer",
                "minimum": 0
              },
              "mapped": {
                "type": "integer",
                "minimum": 0
              },
              "dropped": {
                "type": "integer",
                "minimum": 0
              },
              "droppedBy": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "required": [
              "format",
              "received",
              "mapped",
              "dropped",
              "droppedBy"
            ]
          }
        },
        "required": [
          "ok",
          "dumpKey",
          "ingest"
        ]
      },
      "HookStorageFailure": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "enum": [
              false
            ]
          },
          "dumpKey": {
            "type": "string"
          },
          "error": {
            "type": "string"
          },
          "ingest": {
            "type": "object",
            "properties": {
              "format": {
                "type": "string",
                "enum": [
                  "health-exporter-v1",
                  "metrics-v1",
                  "unknown"
                ]
              },
              "received": {
                "type": "integer",
                "minimum": 0
              },
              "mapped": {
                "type": "integer",
                "minimum": 0
              },
              "dropped": {
                "type": "integer",
                "minimum": 0
              },
              "droppedBy": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "required": [
              "format",
              "received",
              "mapped",
              "dropped",
              "droppedBy"
            ]
          }
        },
        "required": [
          "ok",
          "error"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "tags": [
          "diagnostics"
        ],
        "responses": {
          "200": {
            "description": "Public liveness.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/timeseries/health": {
      "get": {
        "operationId": "getTimeseriesHealth",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "tags": [
          "diagnostics"
        ],
        "responses": {
          "200": {
            "description": "Authenticated database diagnostic.",
