    "/api/health/samples": {
      "get": {
        "operationId": "listHealthSamples",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "tags": [
          "health"
        ],
        "description": "Samples owned by the session, ordered by time then ID. The range is [from,to), at most 31 days. Cursors are bound to the owner and filters; concurrent imports do not provide snapshot isolation.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "enum": [
                "active_energy_burned",
                "active_energy_goal",
                "basal_energy_burned",
                "stand_time",
                "stand_hour",
                "stand_hours_goal",
                "exercise_time",
                "exercise_time_goal",
                "move_time",
                "move_time_goal",
                "heart_rate",
                "resting_heart_rate",
                "heart_rate_variability"
              ]
            },
            "required": true,
            "name": "metric",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "format": "date-time",
              "description": "Inclusive sample start time, with UTC or an explicit offset."
            },
            "required": true,
            "description": "Inclusive sample start time, with UTC or an explicit offset.",
            "name": "from",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "format": "date-time",
              "description": "Exclusive sample start time. Must be after from and at most 31 days later."
            },
            "required": true,
            "description": "Exclusive sample start time. Must be after from and at most 31 days later.",
            "name": "to",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 100
            },
            "required": false,
            "name": "limit",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "required": false,
            "name": "cursor",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Decrypted observations, or an empty items array.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthSamplesResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or cursor.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "A valid session is required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Trusted origin or fresh passkey verification is required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded; retry later.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "Service unavailable; retry later.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
