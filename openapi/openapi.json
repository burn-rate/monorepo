{
  "openapi": "3.1.0",
  "info": {
    "title": "Burn Rate API",
    "version": "1.0.0",
    "description": "Application contracts. Better Auth endpoints at /api/auth/* use Better Auth and passkeyClient contracts and are intentionally not duplicated here."
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "better-auth.session_token",
        "description": "Better Auth HttpOnly session cookie; production uses its Secure-prefixed variant. Set credentials: include in browser Fetch. WebAuthn ceremonies use Better Auth passkeyClient."
      },
      "ingestionBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Per-user revocable exporter credential. Never authorizes account or health reads."
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "service": {
            "type": "string",
            "enum": [
              "burn-rate-api"
            ]
          }
        },
        "required": [
          "status",
          "service"
        ]
      },
      "TimeseriesHealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "version"
        ]
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "requestId": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message",
              "requestId"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "CurrentUser": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "MetricsResponse": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "enum": [
                    "active_energy_burned",
                    "active_energy_goal",
                    "basal_energy_burned",
                    "stand_time",
                    "stand_hour",
                    "stand_hours_goal",
                    "exercise_time",
                    "exercise_time_goal",
                    "move_time",
                    "move_time_goal",
                    "heart_rate",
                    "resting_heart_rate",
                    "heart_rate_variability"
                  ]
                },
                "displayName": {
                  "type": "string"
                },
                "category": {
                  "type": "string",
                  "enum": [
                    "activity",
                    "vitals"
                  ]
                },
                "unit": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "displayName",
                "category",
                "unit"
              ]
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "HealthSamplesResponse": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "metric": {
                  "type": "string",
                  "enum": [
                    "active_energy_burned",
                    "active_energy_goal",
                    "basal_energy_burned",
                    "stand_time",
                    "stand_hour",
                    "stand_hours_goal",
                    "exercise_time",
                    "exercise_time_goal",
                    "move_time",
                    "move_time_goal",
                    "heart_rate",
                    "resting_heart_rate",
                    "heart_rate_variability"
                  ]
                },
                "time": {
                  "type": "string",
                  "format": "date-time"
                },
                "endedAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "value": {
                  "type": "number"
                },
                "valueMin": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "valueMax": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "unit": {
                  "type": "string"
                },
                "sourceName": {
                  "type": "string"
                },
                "device": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "extId": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "id",
                "metric",
                "time",
                "endedAt",
                "value",
                "valueMin",
                "valueMax",
                "unit",
                "sourceName",
                "device",
                "extId"
              ]
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "items",
          "nextCursor"
        ]
      },
      "CreatedIngestionToken": {
        "type": "object",
        "properties": {
          "token": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "createdAt": {
                "type": "string",
                "format": "date-time"
              },
              "revokedAt": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              }
            },
            "required": [
              "id",
              "name",
              "createdAt",
              "revokedAt"
            ]
          },
          "secret": {
            "type": "string",
            "description": "Returned once. Store securely; it cannot be retrieved later."
          }
        },
        "required": [
          "token",
          "secret"
        ]
      },
      "CreateIngestionToken": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "required": [
          "name"
        ]
      },
      "IngestionTokensResponse": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "createdAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "revokedAt": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date-time"
                }
              },
              "required": [
                "id",
                "name",
                "createdAt",
                "revokedAt"
              ]
            }
          }
        },
        "required": [
          "items"
        ]
