{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": ["tsconfig.base.json"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", ".svelte-kit/**", "!.svelte-kit/cache/**"]
    },
    "check": {
      "dependsOn": ["^check"],
      "outputs": []
    }
  }
}
