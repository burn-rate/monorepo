---
import '@burn-rate/design-tokens/css';

const title = 'burn-rate';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="The home of burn-rate." />
    <title>{title}</title>
  </head>
  <body>
    <main>
      <h1>{title}</h1>
      <p>Coming soon.</p>
    </main>
  </body>
</html>

<style>
  body {
    margin: 0;
    background: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-sans);
  }

  main {
    max-width: 64rem;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }

  h1 {
    color: var(--color-frosting);
    text-shadow: var(--shadow-sprinkle);
  }

  p {
    color: var(--color-text-muted);
  }
</style>
