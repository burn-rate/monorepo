{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api",
  "main": "src/index.ts",
  "account_id": "888e985dae423cb6bab33658a25951de",
  "compatibility_date": "2026-10-21",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "DASHBOARD_URL": "https://app.burn-rate-app.workers.dev",
    "BETTER_AUTH_URL": "https://api.burn-rate-app.workers.dev",
    "PASSKEY_RP_ID": "burn-rate-app.workers.dev"
  },
  "r2_buckets": [
    {
      "binding": "HOOK_DUMPS",
      "bucket_name": "burn-rate-hook-dumps"
    }
  ],
  "hyperdrive": [
    {
      "binding": "TIMESERIES_DB",
      "id": "2985aac84d524fbdb926e35d5cdf3eb2"
    }
  ]
}
