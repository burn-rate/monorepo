{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "burn-rate-api",
  "main": "src/index.ts",
  "account_id": "a855feec1f62b3f8eb8228967ea169bf",
  "compatibility_date": "2026-10-21",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "r2_buckets": [
    {
      "binding": "HOOK_DUMPS",
      "bucket_name": "burn-rate-hook-dumps"
    }
  ],
  "hyperdrive": [
    {
      "binding": "TIMESERIES_DB",
      "id": "2985aac84d524fbdb926e35d5cdf3eb2"
    }
  ]
}
